# Copy to .env on the server.

# Data roots (where streamers actually write)
HL_DATA_ROOT=/opt/hl-research/data
DYDX_DATA_ROOT=/opt/dydx-edge/data

# Where edge-lab puts its computed parquet/plots
LAB_OUT=/opt/edge-lab/out

# Default research universe (must exist in BOTH venues)
LAB_SYMBOLS=BTC,ETH,SOL

# Date window for analysis (UTC). Empty = "all available days".
LAB_START_DATE=
LAB_END_DATE=
